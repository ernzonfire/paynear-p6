PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret
PUBLIC_API_URL=http://localhost:4000
# Required before production use. Without this value, PayNear uses a non-persistent in-memory development store.
MONGODB_URI=
# Used only after MongoDB connects. Keep this JSON in Render secrets, never in frontend code or Git.
# Every temporary password must contain at least 12 characters. A newly seeded admin must replace it on first sign-in.
# Public registration cannot create admin accounts.
ADMIN_ACCOUNTS_JSON=[{"name":"Admin One","email":"admin.one@example.com","password":"replace-with-a-one-time-temporary-secret"}]
# Optional real AI integration. Set both variables to enable an OpenAI-powered filter assistant.
OPENAI_API_KEY=
OPENAI_MODEL=
