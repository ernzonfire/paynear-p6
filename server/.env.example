PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret
PUBLIC_API_URL=http://localhost:4000
# Optional. Without this value, PayNear starts in in-memory demo mode.
MONGODB_URI=
# Used only after MongoDB connects. The password must contain at least 12 characters.
ADMIN_NAME=PayNear Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional real AI integration. Set both variables to enable an OpenAI-powered filter assistant.
OPENAI_API_KEY=
OPENAI_MODEL=
